# 我们自己的 TimeMark 镜像(自维护 fork:Demo7783/timemark-docker)
#
# 与上游 Dockerfile 的差异(仅三点,便于跟上游 rebase):
#   1. NPM_REGISTRY 构建参数,默认走 npmmirror(容器内 build 直连 npmjs 会超时)
#   2. CMD 修正为 ./backend/dist/index.js
#      上游 CMD 写的是 ./backend/dist/backend/src/index.js,该路径不存在 → 容器无限重启
#   3. 保留 upstream 的两段式(前端 dist 由本地 vite 预构建后 COPY)
#
# 构建:docker build -f Dockerfile.our -t timemark-our:2.30.0-p1 .

ARG NPM_REGISTRY=https://registry.npmmirror.com

# ---------- Stage 1: 编译 shared + backend ----------
FROM node:22.23.4-alpine AS builder

ARG NPM_REGISTRY
WORKDIR /app

RUN npm config set registry ${NPM_REGISTRY} && npm install -g pnpm@9

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY shared/package.json ./shared/
COPY backend/package.json ./backend/

RUN pnpm config set registry ${NPM_REGISTRY} && pnpm install --frozen-lockfile

COPY shared/ ./shared/
COPY backend/ ./backend/

RUN pnpm build:shared && pnpm build:backend

# ---------- Stage 2: 运行时 ----------
FROM node:22.23.4-alpine

ARG NPM_REGISTRY

RUN sed -i 's|https://dl-cdn.alpinelinux.org|https://mirrors.aliyun.com|g' /etc/apk/repositories \
 && apk add --no-cache dumb-init su-exec ca-certificates icu-data-full
RUN npm config set registry ${NPM_REGISTRY}

WORKDIR /app

ENV NODE_ENV=production
ENV TZ=Asia/Shanghai

RUN npm install -g pnpm@9

# 镜像内非 root 用户(上游同名步骤,漏了它 /app 归属会失败)
RUN addgroup -S app && adduser -S app -G app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY shared/package.json ./shared/
COPY backend/package.json ./backend/

RUN pnpm config set registry ${NPM_REGISTRY} && pnpm install --prod --frozen-lockfile --no-optional

COPY --from=builder /app/shared/dist ./shared/dist
COPY --from=builder /app/backend/dist ./backend/dist
COPY frontend/dist ./frontend/dist
COPY docker/schema.sql ./docker/schema.sql

RUN mkdir -p /app/data && chown -R app:app /app

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

USER app

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["node", "./backend/dist/index.js"]
