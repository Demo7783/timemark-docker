# TimeMark Docker — Environment Variables
# 用法：复制为 .env（compose 自动读取），或 docker run -e 逐项注入。
# 生成密钥（Git Bash）: openssl rand -hex 32
# 生成密钥（PowerShell）: -join ((1..64) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })

# === 必填 ===
# 生产环境至少 12 位且非常见弱口令；仅用于空库首次初始化 admin（已有账户不受影响）
DEFAULT_ADMIN_PASSWORD=change-me-to-a-long-random-password

# === 强烈建议 ===
# 32+ 随机字符串；生产缺失会硬失败启动
JWT_SECRET=
# 32+ 随机字符串（AES-256 字段加密主密钥；缺失时自动生成并落盘 data/.env）
MASTER_KEY=
# 外部触发 /api/cron/* 与「立即运行」白名单端点的 Bearer；不配则 cron 端点 fail-closed 500
CRON_SECRET=
# 默认 Asia/Shanghai；按用户 IANA 时区可另配
TZ=Asia/Shanghai

# === 网络与来源（docker/NAS 关键）===
# 额外放行的 CORS/CSRF 来源（逗号分隔，精确 origin）。NAS/LAN 同 Host 访问无需配置；
# 通配符条目会被清洗剔除（凭据 CORS 不允许通配授权）
# CORS_ORIGIN=
# 反向代理的 peer IP/CIDR（逗号分隔）；只有可信代理的 X-Forwarded-* 才会被采信
# TRUSTED_PROXIES=
# 仅可信局域网明文 HTTP 部署时设 true（公网部署必须保持 false，用 HTTPS 反代）
ALLOW_INSECURE_HTTP=false

# === 登录人机验证（可选）===
# 见 docs/TURNSTILE_SETUP.md；两个都配才生效
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# === 附件存储（可选；默认本地持久卷）===
# 不配 BLOB token = 本地磁盘（ATTACHMENT_LOCAL_DIR 或数据卷内 .data/attachments）
# BLOB_READ_WRITE_TOKEN=
# 设 1 恢复「无 Blob token 拒写」语义（对齐 vercel，附件返回 503 而非落盘）
# ATTACHMENT_REQUIRE_BLOB=
# 本地存储目录（默认 <数据卷>/.data/attachments）
# ATTACHMENT_LOCAL_DIR=

# === 浏览器 Web Push（可选；旧名 VAPID_* 仍被兼容读取）===
# 生成：npx web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# 可选，默认 mailto:admin@timemark.app
# PUSH_VAPID_SUBJECT=

# === AI 助手 / 向量检索（可选；留空即禁用，不影响其他功能）===
# OpenAI 兼容接口；主用 + 备用回退。免费云端（Groq/Gemini/OpenRouter）或本地模型均可
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
# 本地模型（Ollama / LM Studio）OpenAI 兼容端点；模型名必填才启用
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_API_KEY=
# 嵌入/语义检索（默认关闭）；开启后文本才会发往嵌入服务
# EMBEDDINGS_ENABLED=
# EMBEDDINGS_MODEL=
# EMBEDDINGS_DIMS=

# === 后台 AI / MCP / Agent（可选；默认全部关闭）===
# AGENT_TOOLS_ENABLED=false
# MCP_ENABLED=false
# MCP_AUTH_TOKEN=
# WORKFLOWS_ENABLED=false
# 出站 Worker 的鉴权 token（外部 worker 才需要）
# AGENT_WORKER_TOKEN=

# === Telegram 双向机器人（可选；也可在设置页加密存储）===
# TELEGRAM_BOT_TOKEN=
# 服务端常量时间校验 X-Telegram-Bot-Api-Secret-Token；留空则 webhook 一律 401
# TELEGRAM_WEBHOOK_SECRET=
# 默认从请求推断 <origin>/api/bot/telegram
# TELEGRAM_WEBHOOK_URL=

# === Google 日历 OAuth 只读同步（可选）===
# 详见 docs/GOOGLE_CALENDAR_OAUTH.md
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://你的域名/api/calendar/google-oauth/callback

# === 运维观测（可选）===
# detailed=1 + 该 token 可见深度健康信息（queueDepth/successRate24h/密钥面）
# HEALTH_DETAIL_TOKEN=
# 上报健康检查平台（heartbeat）
# HEALTHCHECK_URL=
# CSP 违规上报端点（默认已内置 /api/csp-report）
# CSP_REPORT_URI=
# 日志级别 info/debug；LOG_QUERIES=true 打印每条 SQL（排障用）
LOG_LEVEL=info
LOG_QUERIES=false

# === 细调（可选，一般不动）===
# 提醒追发宽限分钟数（错过整点的补发窗口）
# REMINDER_CATCHUP_GRACE_MINUTES=
# cron 端点来源 IP 白名单（默认只信任配置的可信代理链）
# CRON_ALLOWED_IPS=
# WebAuthn 固定 RP（默认自动从请求推断；反代场景可显式固定）
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGIN=
